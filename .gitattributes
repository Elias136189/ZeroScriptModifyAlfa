# POSIX shell scripts MUST keep LF endings: a CRLF checkout makes bash fail with
# "$'\r': command not found". The repo is developed on
# Windows (autocrlf), so pin these explicitly.
*.sh       text eol=lf
# Windows batch files MUST keep CRLF: cmd.exe mis-parses goto/call labels in LF files.
*.bat     text eol=crlf
*.cmd     text eol=crlf
